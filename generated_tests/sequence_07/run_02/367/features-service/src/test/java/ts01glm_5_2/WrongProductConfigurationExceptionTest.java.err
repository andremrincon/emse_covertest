package ts01glm_5_2;

import org.junit.BeforeClass;
import org.junit.Test;
import org.junit.Assert;

import java.io.InputStream;
import java.io.OutputStream;
import java.net.HttpURLConnection;
import java.net.URL;
import java.net.URLEncoder;
import java.nio.charset.StandardCharsets;
import java.util.Map;
import java.util.UUID;
import java.util.LinkedHashMap;

public class WrongProductConfigurationExceptionTest {

    private static String baseUrl;

    @BeforeClass
    public static void setUp() {
        baseUrl = System.getProperty("baseUrl", "http://localhost:8080");
        if (baseUrl.endsWith("/")) {
            baseUrl = baseUrl.substring(0, baseUrl.length() - 1);
        }
    }

    @Test(timeout = 60000)
    public void addFeatureToConfigurationViolatingExcludesConstraintTriggersWrongProductConfigurationException_1() throws Exception {
        String productName = "TestProduct-Excludes-" + UUID.randomUUID().toString().substring(0, 8);
        String featureA = "FeatureA-" + UUID.randomUUID().toString().substring(0, 8);
        String featureB = "FeatureB-" + UUID.randomUUID().toString().substring(0, 8);
        String configName = "config-" + UUID.randomUUID().toString().substring(0, 8);

        int code;

        code = doPost("/products/{productName}", productName);
        Assert.assertTrue(code < 300);

        code = doPost("/products/{productName}/features/{featureName}", productName, featureA);
        Assert.assertTrue(code < 300);

        code = doPost("/products/{productName}/features/{featureName}", productName, featureB);
        Assert.assertTrue(code < 300);

        Map<String,String> form = new LinkedHashMap<String,String>();
        form.put("sourceFeature", featureA);
        form.put("excludedFeature", featureB);
        code = doPostForm("/products/{productName}/constraints/excludes", form, productName);
        Assert.assertTrue(code < 300);

        code = doPost("/products/{productName}/configurations/{configurationName}", productName, configName);
        Assert.assertTrue(code < 300);

        code = doPost("/products/{productName}/configurations/{configurationName}/features/{featureName}", productName, configName, featureA);
        Assert.assertTrue(code < 300);

        code = doPost("/products/{productName}/configurations/{configurationName}/features/{featureName}", productName, configName, featureB);
        Assert.assertEquals(500, code);
    }

    @Test(timeout = 60000)
    public void addFeatureToConfigurationViolatingRequiresConstraintTriggersWrongProductConfigurationException_2() throws Exception {
        String productName = "TestProduct-Requires-" + UUID.randomUUID().toString().substring(0, 8);
        String featureA = "ReqFeatureA-" + UUID.randomUUID().toString().substring(0, 8);
        String featureB = "ReqFeatureB-" + UUID.randomUUID().toString().substring(0, 8);
        String configName = "config-" + UUID.randomUUID().toString().substring(0, 8);

        int code;

        code = doPost("/products/{productName}", productName);
        Assert.assertTrue(code < 300);

        code = doPost("/products/{productName}/features/{featureName}", productName, featureA);
        Assert.assertTrue(code < 300);

        code = doPost("/products/{productName}/features/{featureName}", productName, featureB);
        Assert.assertTrue(code < 300);

        Map<String,String> form = new LinkedHashMap<String,String>();
        form.put("sourceFeature", featureB);
        form.put("requiredFeature", featureA);
        code = doPostForm("/products/{productName}/constraints/requires", form, productName);
        Assert.assertTrue(code < 300);

        code = doPost("/products/{productName}/configurations/{configurationName}", productName, configName);
        Assert.assertTrue(code < 300);

        code = doPost("/products/{productName}/configurations/{configurationName}/features/{featureName}", productName, configName, featureB);
        Assert.assertTrue(code < 300);

        code = doGet("/products/{productName}/configurations/{configurationName}", productName, configName);
        Assert.assertEquals(500, code);
    }

    @Test(timeout = 60000)
    public void getConfigurationWithViolatedExcludesConstraintTriggersWrongProductConfigurationException_3() throws Exception {
        String productName = "TestProduct-GetViol-" + UUID.randomUUID().toString().substring(0, 8);
        String featureA = "ViolFeatureA-" + UUID.randomUUID().toString().substring(0, 8);
        String featureB = "ViolFeatureB-" + UUID.randomUUID().toString().substring(0, 8);
        String configName = "config-" + UUID.randomUUID().toString().substring(0, 8);

        int code;

        code = doPost("/products/{productName}", productName);
        Assert.assertTrue(code < 300);

        code = doPost("/products/{productName}/features/{featureName}", productName, featureA);
        Assert.assertTrue(code < 300);

        code = doPost("/products/{productName}/features/{featureName}", productName, featureB);
        Assert.assertTrue(code < 300);

        Map<String,String> form = new LinkedHashMap<String,String>();
        form.put("sourceFeature", featureA);
        form.put("excludedFeature", featureB);
        code = doPostForm("/products/{productName}/constraints/excludes", form, productName);
        Assert.assertTrue(code < 300);

        code = doPost("/products/{productName}/configurations/{configurationName}", productName, configName);
        Assert.assertTrue(code < 300);

        code = doPost("/products/{productName}/configurations/{configurationName}/features/{featureName}", productName, configName, featureA);
        Assert.assertTrue(code < 300);

        code = doPost("/products/{productName}/configurations/{configurationName}/features/{featureName}", productName, configName, featureB);
        Assert.assertTrue(code < 500);

        code = doGet("/products/{productName}/configurations/{configurationName}", productName, configName);
        Assert.assertEquals(500, code);
    }

    private int doPost(String pathTemplate, String... pathParams) throws Exception {
        String path = buildPath(pathTemplate, pathParams);
        URL url = new URL(baseUrl + path);
        HttpURLConnection conn = (HttpURLConnection) url.openConnection();
        try {
            conn.setRequestMethod("POST");
            conn.setDoOutput(false);
            conn.setConnectTimeout(15000);
            conn.setReadTimeout(15000);
            conn.connect();
            return getResponseCode(conn);
        } finally {
            conn.disconnect();
        }
    }

    private int doPostForm(String pathTemplate, Map<String,String> formParams, String... pathParams) throws Exception {
        String path = buildPath(pathTemplate, pathParams);
        URL url = new URL(baseUrl + path);
        HttpURLConnection conn = (HttpURLConnection) url.openConnection();
        byte[] body = buildFormBody(formParams);
        try {
            conn.setRequestMethod("POST");
            conn.setDoOutput(true);
            conn.setRequestProperty("Content-Type", "application/x-www-form-urlencoded; charset=UTF-8");
            conn.setRequestProperty("Content-Length", String.valueOf(body.length));
            conn.setConnectTimeout(15000);
            conn.setReadTimeout(15000);
            conn.connect();
            OutputStream os = conn.getOutputStream();
            try {
                os.write(body);
                os.flush();
            } finally {
                os.close();
            }
            return getResponseCode(conn);
        } finally {
            conn.disconnect();
        }
    }

    private int doGet(String pathTemplate, String... pathParams) throws Exception {
        String path = buildPath(pathTemplate, pathParams);
        URL url = new URL(baseUrl + path);
        HttpURLConnection conn = (HttpURLConnection) url.openConnection();
        try {
            conn.setRequestMethod("GET");
            conn.setDoOutput(false);
            conn.setConnectTimeout(15000);
            conn.setReadTimeout(15000);
            conn.connect();
            return getResponseCode(conn);
        } finally {
            conn.disconnect();
        }
    }

    private int getResponseCode(HttpURLConnection conn) {
        try {
            int code = conn.getResponseCode();
            InputStream is;
            if (code >= 400) {
                is = conn.getErrorStream();
            } else {
                is = conn.getInputStream();
            }
            if (is != null) {
                try {
                    byte[] buf = new byte[1024];
                    while (is.read(buf) > 0) {
                    }
                } finally {
                    try {
                        is.close();
                    } catch (Exception e) {
                    }
                }
            }
            return code;
        } catch (Exception e) {
            return 500;
        }
    }

    private String buildPath(String template, String... params) {
        String path = template;
        for (String p : params) {
            int start = path.indexOf('{');
            int end = path.indexOf('}', start);
            if (start >= 0 && end > start) {
                String encoded = urlEncode(p);
                path = path.substring(0, start) + encoded + path.substring(end + 1);
            } else {
                if (!path.endsWith("/")) {
                    path = path + "/";
                }
                path = path + urlEncode(p);
            }
        }
        if (!path.startsWith("/")) {
            path = "/" + path;
        }
        return path;
    }

    private byte[] buildFormBody(Map<String,String> formParams) {
        StringBuilder sb = new StringBuilder();
        boolean first = true;
        for (Map.Entry<String,String> e : formParams.entrySet()) {
            if (!first) sb.append("&");
            first = false;
            sb.append(urlEncode(e.getKey()));
            sb.append("=");
            sb.append(urlEncode(e.getValue()));
        }
        return sb.toString().getBytes(StandardCharsets.UTF_8);
    }

    private String urlEncode(String s) {
        try {
            return URLEncoder.encode(s, "UTF-8").replaceAll("\\+", "%20");
        } catch (Exception e) {
            return s;
        }
    }
}