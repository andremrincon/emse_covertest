package ts01glm_5_2;

import org.junit.BeforeClass;
import org.junit.Test;
import org.junit.Assert;

import java.io.OutputStream;
import java.io.InputStream;
import java.io.IOException;
import java.net.HttpURLConnection;
import java.net.URL;
import java.net.URLEncoder;
import java.util.UUID;
import java.util.regex.Matcher;
import java.util.regex.Pattern;

public class ConfigurationEvaluatorTest {

    private static String baseUrl;

    @BeforeClass
    public static void setup() {
        baseUrl = System.getProperty("baseUrl", "http://localhost:8080");
    }

    private static String buildPath(String template, Object... args) throws Exception {
        String result = template;
        Pattern p = Pattern.compile("\\{[^}]+\\}");
        Matcher m = p.matcher(result);
        int i = 0;
        while (m.find() && i < args.length) {
            String encoded = URLEncoder.encode(String.valueOf(args[i]), "UTF-8");
            result = result.substring(0, m.start()) + encoded + result.substring(m.end());
            m = p.matcher(result);
            i++;
        }
        return result;
    }