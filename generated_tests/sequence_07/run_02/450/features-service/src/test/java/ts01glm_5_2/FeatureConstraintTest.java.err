                .then()
                .statusCode(lessThan(300));

        given()
                .when()
                .get("/products/{productName}", productName)
                .then()
                .statusCode(lessThan(300));

        given()
                .when()
                .delete("/products/{productName}/constraints/{constraintId}", productName, 1)
                .then()
                .statusCode(204);
    }

    @Test(timeout = 60000)
    public void getProductWithConstraintsExercisesGetId() {
        String productName = "TestProduct-Get-" + UUID.randomUUID().toString().substring(0, 8);
        String sourceFeature = "FeatureI-" + UUID.randomUUID().toString().substring(0, 8);
        String requiredFeature = "FeatureJ-" + UUID.randomUUID().toString().substring(0, 8);

        given()
                .when()
                .post("/products/{productName}", productName)
                .then()
                .statusCode(lessThan(300));

        given()
                .contentType(ContentType.URLENC)
                .formParam("description", "Source")
                .when()
                .post("/products/{productName}/features/{featureName}", productName, sourceFeature)
                .then()
                .statusCode(lessThan(300));

        given()
                .contentType(ContentType.URLENC)
                .formParam("description", "Required")
                .when()
                .post("/products/{productName}/features/{featureName}", productName, requiredFeature)
                .then()
                .statusCode(lessThan(300));

        given()
                .contentType(ContentType.URLENC)
                .formParam("sourceFeature", sourceFeature)
                .formParam("requiredFeature", requiredFeature)
                .when()
                .post("/products/{productName}/constraints/requires", productName)
                .then()
                .statusCode(lessThan(300));

        given()
                .when()
                .get("/products/{productName}", productName)
                .then()
                .statusCode(200);
    }

    @Test(timeout = 60000)
    public void createRequiresConstraintForNonExistentProductReturnsError() {
        String productName = "NonExistentProduct-" + UUID.randomUUID().toString().substring(0, 8);

        given()
                .contentType(ContentType.URLENC)
                .formParam("sourceFeature", "FeatureX")
                .formParam("requiredFeature", "FeatureY")
                .when()
                .post("/products/{productName}/constraints/requires", productName)
                .then()
                .statusCode(500);
    }

    @Test(timeout = 60000)
    public void createExcludesConstraintForNonExistentProductReturnsError() {
        String productName = "NonExistentProduct2-" + UUID.randomUUID().toString().substring(0, 8);

        given()
                .contentType(ContentType.URLENC)
                .formParam("sourceFeature", "FeatureX")
                .formParam("excludedFeature", "FeatureY")
                .when()
                .post("/products/{productName}/constraints/excludes", productName)
                .then()
                .statusCode(500);
    }

    @Test(timeout = 60000)
    public void createRequiresConstraintWithNonExistentFeaturesReturnsError() {
        String productName = "TestProduct-NoFeat-" + UUID.randomUUID().toString().substring(0, 8);

        given()
                .when()
                .post("/products/{productName}", productName)
                .then()
                .statusCode(lessThan(300));

        given()
                .contentType(ContentType.URLENC)
                .formParam("sourceFeature", "NonExistentFeature")
                .formParam("requiredFeature", "AlsoNonExistent")
                .when()
                .post("/products/{productName}/constraints/requires", productName)
                .then()
                .statusCode(500);
    }

    @Test(timeout = 60000)
    public void deleteNonExistentConstraintReturnsError() {
        String productName = "TestProduct-NoConstraint-" + UUID.randomUUID().toString().substring(0, 8);

        given()
                .when()
                .post("/products/{productName}", productName)
                .then()
                .statusCode(lessThan(300));

        given()
                .when()
                .delete("/products/{productName}/constraints/{constraintId}", productName, 99999)
                .then()
                .statusCode(500);
    }

    private static RequestSpecification given() {
        return RestAssured.given();
    }
}