        given()
                .when()
                .post("/products/{productName}/configurations/{configurationName}", uniqueProduct, configName)
                .then()
                .statusCode(lessThan(300));

        given()
                .when()
                .post("/products/{productName}/configurations/{configurationName}/features/{featureName}", uniqueProduct, configName, sourceFeature)
                .then()
                .statusCode(lessThan(300));

        given()
                .when()
                .get("/products/{productName}/configurations/{configurationName}/features", uniqueProduct, configName)
                .then()
                .statusCode(200);
    }

