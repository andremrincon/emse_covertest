package ts01qwen3_7_plus_2;

import io.restassured.RestAssured;
import org.junit.BeforeClass;
import org.junit.Test;

import static io.restassured.RestAssured.given;
import static org.hamcrest.Matchers.equalTo;
import static org.hamcrest.Matchers.lessThan;

import org.junit.Ignore;
public class TriangleClassificationTest {

    @BeforeClass
    public static void setup() {
        RestAssured.baseURI = System.getenv("BASE_URL") != null ? System.getenv("BASE_URL") : "http://localhost:8080";
    }

    @Ignore("1 expectation failed. Response body doesn't match expectation. Expected: \"isosceles\"   Actual: ...")
    @Test(timeout = 60000)
    public void testIsoscelesTriangle() {
        given()
            .pathParam("a", 3)
            .pathParam("b", 3)
            .pathParam("c", 4)
        .when()
            .get("/api/triangle/{a}/{b}/{c}")
        .then()
            .statusCode(200)
            .body(equalTo("isosceles"));
    }

    @Ignore("1 expectation failed. Response body doesn't match expectation. Expected: \"invalid\"   Actual: {\...")
    @Test(timeout = 60000)
    public void testTriangleInequalityViolation() {
        given()
            .pathParam("a", 1)
            .pathParam("b", 1)
            .pathParam("c", 10)
        .when()
            .get("/api/triangle/{a}/{b}/{c}")
        .then()
            .statusCode(200)
            .body(equalTo("invalid"));
    }

    @Ignore("1 expectation failed. Response body doesn't match expectation. Expected: \"equilateral\"   Actual...")
    @Test(timeout = 60000)
    public void testEquilateralTriangle() {
        given()
            .pathParam("a", 3)
            .pathParam("b", 3)
            .pathParam("c", 3)
        .when()
            .get("/api/triangle/{a}/{b}/{c}")
        .then()
            .statusCode(200)
            .body(equalTo("equilateral"));
    }

    @Ignore("1 expectation failed. Response body doesn't match expectation. Expected: \"right\"   Actual: {\"r...")
    @Test(timeout = 60000)
    public void testScaleneTriangle() {
        given()
            .pathParam("a", 3)
            .pathParam("b", 4)
            .pathParam("c", 5)
        .when()
            .get("/api/triangle/{a}/{b}/{c}")
        .then()
            .statusCode(200)
            .body(equalTo("right"));
    }

    @Ignore("1 expectation failed. Response body doesn't match expectation. Expected: \"invalid\"   Actual: {\...")
    @Test(timeout = 60000)
    public void testNonPositiveSides() {
        given()
            .pathParam("a", 0)
            .pathParam("b", 3)
            .pathParam("c", 4)
        .when()
            .get("/api/triangle/{a}/{b}/{c}")
        .then()
            .statusCode(200)
            .body(equalTo("invalid"));
    }
}