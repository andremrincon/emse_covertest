            .get("/v1/alpha/US")
        .then()
            .statusCode(lessThan(300));

        given()
            .baseUri(System.getProperty("baseUrl", "http://localhost:8080/rest"))
        .when()
            .get("/v1/alpha/US")
        .then()
            .statusCode(200)
            .body("translations.ja", equalTo("アメリカ合衆国"));
    }

